# Generated by Ansible (src-component-rsdat).
[Unit]
Description=RS-DAT Prefect server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ rsdat_user }}
Group={{ rsdat_user }}
Environment=PREFECT_HOME={{ rsdat_prefect_home }}
# UI served under {{ rsdat_prefect_path }} behind SRC-Nginx; the browser reaches the API there too
Environment=PREFECT_UI_SERVE_BASE={{ rsdat_prefect_path | regex_replace('/$', '') }}
{% if rsdat_nginx_enabled | bool %}
Environment=PREFECT_UI_API_URL=https://{{ rsdat_fqdn }}{{ rsdat_prefect_path }}api
{% else %}
# no SRC-Nginx: the browser reaches the API through an SSH tunnel to this port
Environment=PREFECT_UI_API_URL=http://localhost:{{ rsdat_prefect_port }}/api
{% endif %}
Environment=PREFECT_SERVER_ANALYTICS_ENABLED=false
# Prefect builds the UI for the serve base by copying it; by default into its own package
# directory, which the service user can't write (root-owned environment): no UI, every page 404
Environment=PREFECT_UI_STATIC_DIRECTORY={{ rsdat_prefect_home }}/ui-build
ExecStart={{ rsdat_venv }}/bin/prefect server start --host 127.0.0.1 --port {{ rsdat_prefect_port }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
