# Generated by Ansible (src-component-rsdat). Included by SRC-Nginx.
{% macro auth() %}
{% if rsdat_nginx_auth == 'sram' %}
    error_page 401 = @custom_401;
    auth_request /validate;
    auth_request_set $username $upstream_http_username;
    proxy_set_header REMOTE_USER $username;
{% endif %}
{% endmacro %}
{% macro proxy_headers() %}
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600;
    proxy_send_timeout 3600;
    client_max_body_size 10G;
{% endmacro %}

# JupyterLab (Dask and git extensions)
location {{ rsdat_jupyterlab_path }} {
{{ auth() }}
    proxy_pass http://127.0.0.1:{{ rsdat_jupyterlab_port }};
{{ proxy_headers() }}
}
{% if rsdat_prefect_enabled | bool %}
{% if rsdat_prefect_api_auth | bool %}
{% set prefect_basic = (rsdat_user ~ ':' ~ rsdat_prefect_password) | b64encode %}
{% endif %}
{% macro prefect_user() %}
{{ auth() }}
{% if rsdat_prefect_api_auth | bool %}
    # after the SRAM login nginx adds the Prefect password: users never see or type it
    proxy_set_header Authorization "Basic {{ prefect_basic }}";
{% endif %}
{% endmacro %}

# Prefect for people (browser): UI and the API it uses, behind the SRAM login
location {{ rsdat_prefect_path }}api/ {
{{ prefect_user() }}
    proxy_pass http://127.0.0.1:{{ rsdat_prefect_port }}/api/;
{{ proxy_headers() }}
}

location {{ rsdat_prefect_path }} {
{{ prefect_user() }}
    proxy_pass http://127.0.0.1:{{ rsdat_prefect_port }};
{{ proxy_headers() }}
}
{% if rsdat_prefect_api_auth | bool %}

# The UI asks for the Prefect password when the server has one; behind the SRAM login nginx
# sends it, so tell the UI not to ask
location ~ ^{{ rsdat_prefect_path }}(.+/)?ui-settings$ {
{{ prefect_user() }}
    proxy_pass http://127.0.0.1:{{ rsdat_prefect_port }};
{{ proxy_headers() }}
    proxy_set_header Accept-Encoding "";
    sub_filter_types application/json;
    sub_filter '"auth":"BASIC"' '"auth":null';
    sub_filter_once on;
}

# Prefect for machines: notebooks and the Dask workers (Prefect tasks with DaskTaskRunner),
# which can't do the SRAM login. Protected by Prefect's own password instead (PREFECT_API_URL
# and PREFECT_API_AUTH_STRING in their settings)
location {{ rsdat_prefect_machine_path }} {
    proxy_pass http://127.0.0.1:{{ rsdat_prefect_port }}/api/;
{{ proxy_headers() }}
}
{% endif %}
{% endif %}
