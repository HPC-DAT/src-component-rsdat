# Generated by Ansible (src-component-rsdat). Included by SRC-Nginx.
{% macro auth() %}
{% if rsdat_nginx_auth == 'sram' %}
    error_page 401 = @custom_401;
    auth_request /validate;
    auth_request_set $username $upstream_http_username;
    proxy_set_header REMOTE_USER $username;
{% endif %}
{% endmacro %}
{% macro proxy_headers() %}
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600;
    proxy_send_timeout 3600;
    client_max_body_size 10G;
{% endmacro %}

# JupyterLab (Dask and git extensions)
location {{ rsdat_jupyterlab_path }} {
{{ auth() }}
    proxy_pass http://127.0.0.1:{{ rsdat_jupyterlab_port }};
{{ proxy_headers() }}
}
{% if rsdat_prefect_enabled | bool %}

# Prefect API (used by the Prefect UI in the browser)
# The API also serves the Dask workers (Prefect tasks with DaskTaskRunner), which can't do the
# SRAM login: with rsdat_prefect_api_auth it's protected by Prefect's own password instead.
location {{ rsdat_prefect_path }}api/ {
{% if not rsdat_prefect_api_auth | bool %}
{{ auth() }}
{% endif %}
    proxy_pass http://127.0.0.1:{{ rsdat_prefect_port }}/api/;
{{ proxy_headers() }}
}

# Prefect UI
location {{ rsdat_prefect_path }} {
{{ auth() }}
    proxy_pass http://127.0.0.1:{{ rsdat_prefect_port }};
{{ proxy_headers() }}
}
{% endif %}
{% if rsdat_nginx_root_redirect | bool %}

location = / {
    return 302 {{ rsdat_jupyterlab_path }};
}
{% endif %}
