#!/bin/bash
# Generated by Ansible (src-component-rsdat).
# '{{ item }}' on the cluster's login node ({{ rsdat_slurm_host }}) over SSH, with the
# workspace's key ({{ rsdat_slurm_ssh_dir }}/id_ed25519, registered in the SURF CUA portal).
# Each argument is quoted for the remote shell.
ssh_cmd=(ssh -F {{ rsdat_slurm_ssh_config }} rsdat-slurm)
{% if item == 'sbatch' %}
# dask-jobqueue passes the job script as a local file (last argument): send it on stdin
if [ $# -gt 0 ] && [ -f "${!#}" ]; then
    exec "${ssh_cmd[@]}" "$(printf '%q ' sbatch "${@:1:$#-1}")" < "${!#}"
fi
{% endif %}
exec "${ssh_cmd[@]}" "$(printf '%q ' {{ item }} "$@")"
