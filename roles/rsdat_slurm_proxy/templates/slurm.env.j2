# Generated by Ansible (src-component-rsdat). Settings for the Slurm commands in {{ rsdat_slurm_bin }}.
# Personal settings in ~/.config/rsdat/slurm.env (see rsdat-slurm-token) take precedence.
PROXY_SLURM_API_URL={{ rsdat_slurm_api_url }}
{% if rsdat_slurm_jwt | length > 0 %}
{#  The token's user: its 'sun' claim (base64url payload, padding stripped), as rsdat-slurm-token does #}
{%   set payload = rsdat_slurm_jwt.split('.')[1] | replace('-', '+') | replace('_', '/') %}
{%   set claims = (payload ~ '=' * ((4 - payload | length % 4) % 4)) | b64decode | from_json %}
{%   set user = claims.sun | default(claims.username | default('')) %}
{%   if user | length > 0 %}
SLURM_USER={{ user }}
{%   endif %}
SLURM_JWT={{ rsdat_slurm_jwt }}
{% endif %}
