#!/bin/bash
# Generated by Ansible (src-component-rsdat).
# '{{ item }}' through the Slurm REST API (SLURM-CLI-API-Proxy client). Settings are read on
# every call, so a new token (rsdat-slurm-token) works without restarting anything.
for f in {{ rsdat_config_dir }}/slurm.env "${XDG_CONFIG_HOME:-$HOME/.config}/rsdat/slurm.env"; do
    if [ -r "$f" ]; then set -a; . "$f"; set +a; fi
done
exec {{ rsdat_venv }}/bin/{{ item }} "$@"
