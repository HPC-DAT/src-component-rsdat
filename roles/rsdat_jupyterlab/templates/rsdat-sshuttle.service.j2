# Generated by Ansible (src-component-rsdat).
[Unit]
Description=RS-DAT sshuttle: the Dask worker network ({{ rsdat_dask_worker_network }}) through {{ rsdat_slurm_host }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root: sshuttle sets up iptables rules. SSH with the workspace's key ({{ rsdat_slurm_ssh_config }});
# no shared control connection with the Slurm commands (those run as {{ rsdat_user }}).
ExecStart=/usr/bin/sshuttle -r rsdat-slurm --ssh-cmd "ssh -F {{ rsdat_slurm_ssh_config }} -o ControlMaster=no -o ControlPath=none" {{ rsdat_dask_worker_network }}
# until the key is registered on the cluster (SURF CUA portal) it can't connect: keep trying
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
