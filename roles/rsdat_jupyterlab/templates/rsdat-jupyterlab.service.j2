# Generated by Ansible (src-component-rsdat).
[Unit]
Description=RS-DAT JupyterLab (Dask on Slurm through the Slurm REST API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ rsdat_user }}
Group={{ rsdat_user }}
WorkingDirectory={{ rsdat_jupyterlab_root_dir }}
# Slurm commands through the REST API come first, so dask-jobqueue uses them
Environment=PATH={{ rsdat_slurm_bin }}:{{ rsdat_venv }}/bin:/usr/local/bin:/usr/bin:/bin
Environment=JUPYTER_CONFIG_DIR={{ rsdat_config_dir }}/jupyter
Environment=SHELL=/bin/bash
{% if rsdat_prefect_enabled | bool %}
Environment=PREFECT_API_URL=http://127.0.0.1:{{ rsdat_prefect_port }}/api
{% endif %}
ExecStart={{ rsdat_venv }}/bin/jupyter lab --config={{ rsdat_config_dir }}/jupyter/jupyter_server_config.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
