# Generated by Ansible (src-component-rsdat).
# Defaults for dask_jobqueue.SLURMCluster and rsdat_dask.RSDATSLURMCluster on this workspace.
# Workers are submitted with sbatch and stopped with scancel from {{ rsdat_slurm_bin }},
# i.e. through the Slurm REST API.
{% set prologue = rsdat_dask_job_script_prologue | list %}
{% set directives = rsdat_dask_job_extra_directives | list %}
{% if rsdat_dask_job_directory | length > 0 %}
{% set prologue = ['mkdir -p "' ~ rsdat_dask_job_directory ~ '" && cd "' ~ rsdat_dask_job_directory ~ '"'] + prologue %}
{% endif %}
{#  Job logs: written by the job itself, which creates the directory on the cluster first.
    (dask-jobqueue's log-directory would create the directory on this workspace instead, and
    Slurm doesn't create the directory for #SBATCH --output.) Errors before this line, which
    are only in the #SBATCH header, show in squeue. #}
{% if rsdat_dask_log_directory | length > 0 %}
{% set prologue = ['mkdir -p "' ~ rsdat_dask_log_directory ~ '" && exec >>"' ~ rsdat_dask_log_directory ~ '/${SLURM_JOB_NAME:-dask-worker}-${SLURM_JOB_ID}.log" 2>&1'] + prologue %}
{% set directives = ['--output=/dev/null'] + directives %}
{% endif %}
{#  Jobs submitted through the REST API don't get HOME (slurmd doesn't set it); the log
    directory, Apptainer's cache and Python's user paths need it. #}
{% set prologue = ['export HOME="${HOME:-$(getent passwd "$(id -un)" | cut -d: -f6)}"'] + prologue %}
{% if rsdat_dask_worker_python | length > 0 %}
{%   set worker_python = rsdat_dask_worker_python %}
{% else %}
{#   Worker image: run Python in the container, with the host's data directories bound (home,
     project space, scratch, $TMPDIR, ...) as in RS-DAT/JDS_development_template. Not the
     system directories: the host's /usr, /opt, /etc, ... would hide the image's own Python
     and libraries. /tmp is bound by Apptainer itself. #}
{%   set worker_python = (['apptainer', 'exec'] + (rsdat_dask_worker_apptainer_args | list) + [rsdat_dask_worker_image, 'python']) | join(' ') %}
{%   set prologue = prologue + [
       'export APPTAINER_BIND=$(ls -1 / | grep -vxE "bin|boot|dev|etc|lib|lib32|lib64|libx32|lost\\+found|media|opt|proc|root|run|sbin|srv|sys|tmp|usr|var" | sed "s|^|/|" | paste -sd, -)',
       'export APPTAINER_TMPDIR="${TMPDIR:-/tmp}"'
     ] %}
{% endif %}
{% set worker_args = [] %}
{% if rsdat_dask_worker_network | length > 0 %}
{#  Pick the node's address in the worker network when the job starts (interface names differ
    between node types); the worker listens on it and advertises it to the scheduler. #}
{#  Plain shell + awk on the host (not the worker's Python, which may run in a container):
    list the node's IPv4 addresses (ip, else hostname -I) and take the first in the network.
    int(a / size), not %: mawk's % overflows above 2^31 (e.g. 145.136.x.x); no regex {n}
    repeats either (older mawk doesn't support them). #}
{% set awk_pick = "awk -v net=" ~ rsdat_dask_worker_network ~ " 'function n(a, p) { split(a, p, \".\"); return ((p[1] * 256 + p[2]) * 256 + p[3]) * 256 + p[4] } BEGIN { split(net, x, \"/\"); size = 2 ^ (32 - x[2]); base = int(n(x[1]) / size) } { a = $1; sub(/\\/.*/, \"\", a); if (a ~ /^[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+$/ && int(n(a) / size) == base) { print a; exit } }'" %}
{% set prologue = prologue + [
     'RSDAT_WORKER_IP=$( { ip -4 -o addr show 2>/dev/null | awk \'{print $4}\' || true; hostname -I 2>/dev/null | tr " " "\\n"; } | ' ~ awk_pick ~ ')',
     'test -n "$RSDAT_WORKER_IP" || { echo "rsdat: no address in ' ~ rsdat_dask_worker_network ~ ' on $(hostname)" >&2; exit 1; }'
   ] %}
{% set worker_args = worker_args + ['--host', '$RSDAT_WORKER_IP'] %}
{% endif %}
{% if rsdat_dask_worker_port | length > 0 %}{% set worker_args = worker_args + ['--worker-port', rsdat_dask_worker_port] %}{% endif %}
{% if rsdat_dask_nanny_port | length > 0 %}{% set worker_args = worker_args + ['--nanny-port', rsdat_dask_nanny_port] %}{% endif %}
jobqueue:
  slurm:
    cores: {{ rsdat_dask_cores }}
    processes: {{ rsdat_dask_processes }}
    memory: "{{ rsdat_dask_memory }}"
    walltime: "{{ rsdat_dask_walltime }}"
    queue: {{ (rsdat_dask_queue | to_json) if rsdat_dask_queue else 'null' }}
    account: {{ (rsdat_dask_account | to_json) if rsdat_dask_account else 'null' }}
    python: {{ worker_python | to_json }}
    job-script-prologue: {{ prologue | to_json }}
    job-extra-directives: {{ directives | to_json }}
    log-directory: null
    # expanded on the node when the job starts (node-local scratch)
    local-directory: {{ (rsdat_dask_local_directory | to_json) if rsdat_dask_local_directory else 'null' }}
    worker-extra-args: {{ worker_args | to_json }}
    scheduler-options:
      host: {{ rsdat_dask_scheduler_host | to_json }}
      port: {{ rsdat_dask_scheduler_port }}
      dashboard_address: "127.0.0.1:{{ rsdat_dask_dashboard_port }}"

rsdat:
  # where RSDATSLURMCluster runs the scheduler: "cluster" (Slurm job + SSH tunnel) or "workspace"
  scheduler-location: {{ rsdat_dask_scheduler_location | to_json }}
{% if rsdat_dask_scheduler_location == 'cluster' %}
  scheduler:
    cores: {{ rsdat_dask_scheduler_cores }}
    memory: "{{ rsdat_dask_scheduler_memory }}"
    walltime: "{{ rsdat_dask_scheduler_walltime }}"
    job-extra-directives: {{ ((['--output=/dev/null'] if rsdat_dask_log_directory | length > 0 else []) + (rsdat_dask_scheduler_job_extra_directives | list)) | to_json }}
    start-timeout: {{ rsdat_dask_scheduler_start_timeout }}
    tunnel-give-up: {{ rsdat_dask_tunnel_give_up }}
  tunnel:
    host: {{ rsdat_dask_tunnel_host | to_json }}
    port: {{ rsdat_dask_tunnel_port }}
    user: {{ rsdat_user | to_json }}
    key-file: {{ (rsdat_dask_tunnel_dir ~ '/id_ed25519') | to_json }}
    host-key-file: {{ rsdat_dask_tunnel_host_key | to_json }}
{% else %}
  # Host the workers use to reach the scheduler (distributed's own contact_address option
  # has no effect)
  scheduler-contact-host: {{ (rsdat_dask_contact_host | to_json) if rsdat_dask_contact_host else 'null' }}
{% endif %}

distributed:
  dashboard:
    # dashboards are reached through JupyterLab (jupyter-server-proxy)
    link: "{{ rsdat_jupyterlab_path }}proxy/{port}/status"
{% if rsdat_dask_tls | bool %}
  comm:
    # TLS for scheduler, workers and clients; plain tcp:// connections are refused.
    # RSDATSLURMCluster passes the certificate to the workers in the job script.
    require-encryption: true
    tls:
      ca-file: {{ (rsdat_dask_tls_dir ~ '/ca.pem') | to_json }}
      scheduler:
        cert: {{ (rsdat_dask_tls_dir ~ '/dask.pem') | to_json }}
        key: {{ (rsdat_dask_tls_dir ~ '/dask.key') | to_json }}
      worker:
        cert: {{ (rsdat_dask_tls_dir ~ '/dask.pem') | to_json }}
        key: {{ (rsdat_dask_tls_dir ~ '/dask.key') | to_json }}
      client:
        cert: {{ (rsdat_dask_tls_dir ~ '/dask.pem') | to_json }}
        key: {{ (rsdat_dask_tls_dir ~ '/dask.key') | to_json }}
{% endif %}

labextension:
  factory:
    module: rsdat_dask
    class: RSDATSLURMCluster
    args: []
    kwargs: {}
  default:
    workers: null
    adapt: null
