# Generated by Ansible (src-component-rsdat).
# JupyterLab behind SRC-Nginx: only reachable on localhost, users are authenticated by SRAM in
# nginx, so Jupyter's own token/password login is disabled.
c = get_config()  # noqa: F821

c.ServerApp.ip = "127.0.0.1"
c.ServerApp.port = {{ rsdat_jupyterlab_port }}
c.ServerApp.base_url = "{{ rsdat_jupyterlab_path }}"
c.ServerApp.root_dir = "{{ rsdat_jupyterlab_root_dir }}"
{% if rsdat_jupyterlab_open_start_here | bool %}
# opening /jupyter/ shows the guide (relative to root_dir); /jupyter/lab stays the plain start page.
# (LabApp, not ServerApp: JupyterLab sets the server's default_url itself)
c.LabApp.default_url = "/lab/tree/RS-DAT-start-here.ipynb"
{% endif %}
c.ServerApp.open_browser = False
c.ServerApp.allow_remote_access = True
c.ServerApp.trust_xheaders = True
c.IdentityProvider.token = ""
c.PasswordIdentityProvider.hashed_password = ""
c.PasswordIdentityProvider.password_required = False
# Requests come from https://{{ rsdat_fqdn }} through nginx
{% if rsdat_nginx_enabled | bool %}
c.ServerApp.allow_origin = "https://{{ rsdat_fqdn }}"
{% endif %}
